{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ottahen/XO-LICENSE/schema/xo-origin.schema.json",
  "title": "XO-ORIGIN Record",
  "description": "Draft schema for XO-ORIGIN.json (XO License, version 1.0). Created by OTTAHEN. This is a proposed schema, not an established standard.",
  "type": "object",
  "required": ["format", "version", "license", "project", "creator"],
  "properties": {
    "format": { "const": "XO-ORIGIN" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
    "license": { "type": "string", "pattern": "^XO-[A-Za-z0-9.]+$" },
    "project": {
      "type": "object",
      "required": ["name", "repository"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "origin_id": { "type": ["string", "null"], "pattern": "^XO-[A-Z0-9]+-[0-9]+$" },
        "repository": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "creator": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "stylized": { "type": "string" },
        "github": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "upstream": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "creator", "repository", "relationship"],
        "properties": {
          "name": { "type": "string" },
          "origin_id": { "type": ["string", "null"] },
          "creator": { "type": "string" },
          "repository": { "type": "string", "format": "uri" },
          "relationship": {
            "enum": ["fork", "port", "translation", "rewrite", "extension", "other"]
          }
        },
        "additionalProperties": true
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "contribution": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "modifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "by", "summary"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "by": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "signature": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
